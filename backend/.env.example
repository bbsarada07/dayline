# Copy to .env and fill in. Never commit .env.

# Long random string used to sign session cookies.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# SQLite file (default: backend/dayline.db)
# DATABASE_URL=sqlite:///./dayline.db

# Port the API listens on (host is always 0.0.0.0)
PORT=8000

# Days a login stays valid
SESSION_DAYS=7

# Demo mode: serve the built frontend (frontend/dist) from this server on one URL
SERVE_FRONTEND=false

# Only needed if the frontend is served from a different origin without the Vite proxy
# CORS_ORIGINS=http://localhost:5173

# Vector database (Qdrant Cloud) and Lyzr API. Not used by the app yet.
QDRANT_URL=
QDRANT_API_KEY=
LYZR_API_KEY=
