# Copy to .env and fill in. Never commit .env.
# On a host (Render, Hugging Face), set these as environment variables / secrets instead.

# --- App -------------------------------------------------------------------

# Long random string used to sign session cookies.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Public URL of the deployment, e.g. https://dayline.onrender.com
# Used for Omi webhook URLs and Secure cookies. On Render / Hugging Face it is
# filled in automatically when left empty.
PUBLIC_BASE_URL=

# true = demo deployment: demo clock starts Monday 12:20, "Reset demo" button,
# demo accounts listed on the login screen, "Simulate scan" on staff desks.
DEMO_MODE=true

# Agents: lyzr (real Lyzr agents) or mock (keyword router, no API key, no credits).
# lyzr only takes effect when LYZR_API_KEY and the four main agent ids are set.
AGENT_MODE=mock

# SQLite file (default: backend/dayline.db)
# DATABASE_URL=sqlite:///./dayline.db

# Where uploaded PDFs are kept (default: backend/uploads). Losing them on restart is fine.
# UPLOAD_DIR=/tmp/dayline-uploads

# Port the API listens on (host is always 0.0.0.0). Hosts usually set this.
PORT=8000

# Days a login stays valid
SESSION_DAYS=7

# Serve the built frontend (frontend/dist) from this server on one URL
SERVE_FRONTEND=false

# Only needed if the frontend is served from a different origin without the Vite proxy
# CORS_ORIGINS=http://localhost:5173

# --- Lyzr: the agents (Phase 7) ------------------------------------------------
LYZR_API_KEY=
# Model for the agents scripts/setup_lyzr.py creates (the cheapest is the 1x credit baseline)
LYZR_MODEL=gpt-4o-mini
# An agent you made by hand in Lyzr Studio with that model: setup_lyzr.py copies its
# provider and credential settings (the API doesn't list them).
LYZR_TEMPLATE_AGENT_ID=
# Seconds to wait for one agent reply before the offline router answers instead
LYZR_TIMEOUT_SECONDS=20
# Real Lyzr calls allowed per day (the server count resets at midnight); then the offline router answers
LYZR_DAILY_CALL_LIMIT=100
# Printed by scripts/setup_lyzr.py
LYZR_ORCHESTRATOR_AGENT_ID=
LYZR_TIMETABLE_AGENT_ID=
LYZR_PRINT_AGENT_ID=
LYZR_CANTEEN_AGENT_ID=
LYZR_LISTENER_AGENT_ID=

# --- Qdrant: shared agent memory (Phase 6) -------------------------------------
# Without these (or if Qdrant can't be reached) memories go to a temporary in-process
# store and the Memory screen says so.
QDRANT_URL=
QDRANT_API_KEY=
# Collection name. Use a different one locally so development never mixes with the
# deployed app, e.g. QDRANT_COLLECTION=dayline_memory_dev
QDRANT_COLLECTION=dayline_memory
# Embedding model run by Qdrant Cloud Inference (free on free-tier clusters, 384 dimensions)
MEMORY_MODEL=sentence-transformers/all-minilm-l6-v2

# --- Omi: voice and ambient capture (Phase 8) ----------------------------------
OMI_APP_ID=
OMI_APP_SECRET=

# --- Agent tool endpoints (Phase 7) ---------------------------------------------
# Shared secret an externally hosted agent sends (X-Tool-Key) when calling
# /api/agent-tools/*, together with the run's X-Run-Token. Empty = endpoint off.
# Our backend runs the tools itself, so this is optional. Any long random string.
TOOL_KEY=
